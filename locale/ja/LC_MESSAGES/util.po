#: of pwnlib.util.fiddling.bits_str:1
msgid "A wrapper around :func:`bits`, which converts the output into a string."
msgstr ":func:`bits` のラッパーで、出力を文字列に変換します。"

#: of pwnlib.util.fiddling.bitswap:1
msgid "Reverses the bits in every byte of a given string."
msgstr "与えられた文字列の各バイトについて、ビットを反転します。"

#: of pwnlib.util.fiddling.bitswap_int:1
msgid "Reverses the bits of a numbers and returns the result as a new number."
msgstr "数値のビットを反転し、結果を新しい数値として返します。"

#: of pwnlib.util.fiddling.bitswap_int:3
msgid "The number to swap."
msgstr "入れ替える数値。"

#: of pwnlib.util.fiddling.bitswap_int:5
msgid "The width of the integer"
msgstr "整数の幅"

#: of pwnlib.util.fiddling.bnot:1
msgid "Returns the binary inverse of 'value'."
msgstr "'value' のビット反転を返します。"

#: of pwnlib.util.fiddling.enhex:1
msgid "Hex-encodes a string."
msgstr "文字列を 16 進数にエンコードします。"

#: of pwnlib.util.fiddling.hexdump:1
msgid "hexdump(s, width = 16, skip = True, hexii = False, begin = 0, style = None,"
msgstr "hexdump(s, width = 16, skip = True, hexii = False, begin = 0, style = None,"

#: of pwnlib.util.fiddling.hexdump:2
msgid "highlight = None, cyclic = False, groupsize=4, total = True) -> str"
msgstr ""

#: of pwnlib.util.fiddling.hexdump:4
msgid "Return a hexdump-dump of a string."
msgstr "文字列の hexdump を返します。"

#: of pwnlib.util.fiddling.hexdump:6
msgid "The data to hexdump."
msgstr "hexdump するデータ。"

#: of pwnlib.util.fiddling.hexdump:8 pwnlib.util.fiddling.hexdump_iter:9
#: pwnlib.util.fiddling.hexii:5
msgid "The number of characters per line"
msgstr "1 行あたりの文字数"

#: of pwnlib.util.fiddling.hexdump:10 pwnlib.util.fiddling.hexdump_iter:11
msgid "The number of characters per group"
msgstr "1 グループあたりの文字数"

#: of pwnlib.util.fiddling.hexdump:12 pwnlib.util.fiddling.hexdump_iter:13
msgid "Set to True, if repeated lines should be replaced by a \"*\""
msgstr "True にすると、繰り返しの行を \"*\" に置き換えます。"

#: of pwnlib.util.fiddling.hexdump:14 pwnlib.util.fiddling.hexdump_iter:15
msgid "Set to True, if a hexii-dump should be returned instead of a hexdump."
msgstr "True にすると、hexdump の代わりに hexii-dump を返します。"

#: of pwnlib.util.fiddling.hexdump:16 pwnlib.util.fiddling.hexdump_iter:17
msgid "Offset of the first byte to print in the left column"
msgstr "左の列に表示する最初のバイトのオフセット"

#: of pwnlib.util.fiddling.hexdump:18 pwnlib.util.fiddling.hexdump_iter:19
msgid "Color scheme to use."
msgstr "使用する配色。"

#: of pwnlib.util.fiddling.hexdump:20 pwnlib.util.fiddling.hexdump_iter:21
msgid "Byte values to highlight."
msgstr "強調するバイト値。"

#: of pwnlib.util.fiddling.hexdump:22 pwnlib.util.fiddling.hexdump_iter:23
msgid "Attempt to skip consecutive, unmodified cyclic lines"
msgstr "連続する変更のない cyclic の行を省略する"

#: of pwnlib.util.fiddling.hexdump:24 pwnlib.util.fiddling.hexdump_iter:25
msgid "Set to True, if total bytes should be printed"
msgstr "合計バイト数を表示する場合は True にする"

#: of pwnlib.util.fiddling.hexdump:27
msgid "A hexdump-dump in the form of a string."
msgstr "文字列の形式の hexdump。"

#: of pwnlib.util.fiddling.hexdump_iter:1
msgid "hexdump_iter(s, width = 16, skip = True, hexii = False, begin = 0, style = None,"
msgstr "hexdump_iter(s, width = 16, skip = True, hexii = False, begin = 0, style = None,"

#: of pwnlib.util.fiddling.hexdump_iter:2
msgid ""
"highlight = None, cyclic = False, groupsize=4, total = True) -> str "
"generator"
msgstr ""

#: of pwnlib.util.fiddling.hexdump_iter:4
msgid "Return a hexdump-dump of a string as a generator of lines.  Unless you have massive amounts of data you probably want to use :meth:`hexdump`."
msgstr "文字列の hexdump を、行のジェネレータとして返します。大量のデータを扱う場合を除き、通常は :meth:`hexdump` を使うのがよいでしょう。"

#: of pwnlib.util.fiddling.hexdump_iter:7
msgid "File object to dump.  Use :class:`io.BytesIO` or :meth:`hexdump` to dump a byte string."
msgstr "ダンプするファイルオブジェクト。バイト列をダンプするには :class:`io.BytesIO` か :meth:`hexdump` を使います。"

#: of pwnlib.util.fiddling.hexdump_iter:28
msgid "A generator producing the hexdump-dump one line at a time."
msgstr "hexdump を 1 行ずつ生成するジェネレータ。"

#: of pwnlib.util.fiddling.hexii:1
msgid "Return a HEXII-dump of a string."
msgstr "文字列の HEXII-dump を返します。"

#: of pwnlib.util.fiddling.hexii:3
msgid "The bytes to dump"
msgstr "ダンプするバイト列"

#: of pwnlib.util.fiddling.hexii:7
msgid "Should repeated lines be replaced by a \"*\""
msgstr "繰り返しの行を \"*\" に置き換えるかどうか。"

#: of pwnlib.util.fiddling.hexii:10
msgid "A HEXII-dump in the form of a string."
msgstr "文字列の形式の HEXII-dump。"

#: of pwnlib.util.fiddling.hexstr:1
msgid "Escapes byte string into a C representation."
msgstr "バイト列を C の表現にエスケープします。"

#: of pwnlib.util.fiddling.isprint:1
msgid "Return True if a character is printable"
msgstr "文字が表示可能なら True を返す"

#: of pwnlib.util.fiddling.js_escape:1
msgid "Pack data as an escaped Unicode string for use in JavaScript's `unescape()` function"
msgstr "JavaScript の `unescape()` 関数で使うために、データをエスケープした Unicode 文字列としてパックします。"

#: of pwnlib.util.fiddling.js_escape:3
msgid "Bytes to pack"
msgstr "パックするバイト列"

#: of pwnlib.util.fiddling.js_escape:5
msgid "A single byte to use as padding if data is of uneven length"
msgstr "データの長さが奇数のときにパディングに使う 1 バイト"

#: of pwnlib.util.fiddling.js_escape:7
msgid "Endianness with which to pack the string (\"little\"/\"big\")"
msgstr "文字列をパックするときのエンディアン(\"little\"/\"big\")。"

#: of pwnlib.util.fiddling.js_escape:10
msgid "A string representation of the packed data"
msgstr "パックしたデータの文字列表現"

#: of pwnlib.util.fiddling.js_unescape:1
msgid "Unpack an escaped Unicode string from JavaScript's `escape()` function"
msgstr "JavaScript の `escape()` 関数が出力するエスケープ済みの Unicode 文字列をアンパックします。"

#: of pwnlib.util.fiddling.js_unescape:3
msgid "Escaped string to unpack"
msgstr "アンパックするエスケープ済みの文字列"

#: of pwnlib.util.fiddling.js_unescape:5
msgid "Endianness with which to unpack the string (\"little\"/\"big\")"
msgstr "文字列をアンパックするときのエンディアン(\"little\"/\"big\")。"

#: of pwnlib.util.fiddling.js_unescape:8
msgid "A bytes representation of the unpacked data"
msgstr "アンパックしたデータのバイト列表現"

#: of pwnlib.util.fiddling.naf:1
msgid "Returns a generator for the non-adjacent form (NAF[1]) of a number, `n`.  If `naf(n)` generates `z_0, z_1, ...`, then `n == z_0 + z_1 * 2 + z_2 * 2**2, ...`."
msgstr "数値 `n` の非隣接形式(NAF[1])のジェネレータを返します。`naf(n)` が `z_0, z_1, ...` を生成するとき、`n == z_0 + z_1 * 2 + z_2 * 2**2, ...` が成り立ちます。"

#: of pwnlib.util.fiddling.naf:5
msgid "[1] https://en.wikipedia.org/wiki/Non-adjacent_form"
msgstr "[1] https://en.wikipedia.org/wiki/Non-adjacent_form"

#: of pwnlib.util.fiddling.negate:1
msgid "Returns the two's complement of 'value'."
msgstr "'value' の 2 の補数を返します。"

#: of pwnlib.util.fiddling.randoms:1
msgid "Returns a random string of a given length using only the specified alphabet."
msgstr "指定した alphabet だけを使った、指定した長さのランダムな文字列を返します。"

#: of pwnlib.util.fiddling.randoms:3
msgid "The length of the desired string."
msgstr "文字列の望ましい長さ。"

#: of pwnlib.util.fiddling.randoms:5
msgid "The alphabet of allowed characters. Defaults to all lowercase characters."
msgstr "使用できる文字の alphabet。既定はすべての小文字です。"

#: of pwnlib.util.fiddling.randoms:7
msgid "A random string."
msgstr "ランダムな文字列。"

#: of pwnlib.util.fiddling.rol:1
msgid "Returns a rotation by `k` of `n`."
msgstr "`n` を `k` だけ回転した値を返します。"

#: of pwnlib.util.fiddling.rol:3
msgid "When `n` is a number, then means ``((n << k) | (n >> (word_size - k)))`` truncated to `word_size` bits."
msgstr "`n` が数値のときは、`word_size` ビットに切り詰めた ``((n << k) | (n >> (word_size - k)))`` を意味します。"

#: of pwnlib.util.fiddling.rol:5
#, python-format
msgid "When `n` is a list, tuple or string, this is ``n[k % len(n):] + n[:k % len(n)]``."
msgstr "`n` がリスト、タプル、文字列のときは、``n[k % len(n):] + n[:k % len(n)]`` です。"

#: of pwnlib.util.fiddling.rol:7
msgid "The value to rotate."
msgstr "回転する値。"

#: of pwnlib.util.fiddling.rol:8
msgid "The rotation amount. Can be a positive or negative number."
msgstr "回転量。正の数でも負の数でも指定できます。"

#: of pwnlib.util.fiddling.rol:10
msgid "If `n` is a number, then this is the assumed bitsize of `n`.  Defaults to :data:`pwnlib.context.word_size` if `None` ."
msgstr "`n` が数値の場合の、`n` のビット幅として仮定する値。`None` の場合の既定は :data:`pwnlib.context.word_size` です。"

#: of pwnlib.util.fiddling.ror:1
msgid "A simple wrapper around :func:`rol`, which negates the values of `k`."
msgstr ":func:`rol` の簡単なラッパーで、`k` の符号を反転します。"

#: of pwnlib.util.fiddling.tty_escape:1
msgid "Escape data for terminal output. This is useful when sending data to a terminal that may interpret certain bytes as control characters."
msgstr "端末への出力用にデータをエスケープします。特定のバイトを制御文字として解釈する可能性のある端末にデータを送るときに便利です。"

#: of pwnlib.util.fiddling.tty_escape:4
msgid "Check ``stty --all`` for the current settings on your terminal."
msgstr "端末の現在の設定は ``stty --all`` で確認してください。"

#: of pwnlib.util.fiddling.tty_escape:6
msgid "The data to escape"
msgstr "エスケープするデータ"

#: of pwnlib.util.fiddling.tty_escape:8
msgid "The byte to prepend to escape the next character. Defaults to ^V."
msgstr "次の文字をエスケープするために前に付けるバイト。既定は ^V です。"

#: of pwnlib.util.fiddling.tty_escape:10
msgid "The bytes to escape"
msgstr "エスケープするバイト列"

#: of pwnlib.util.fiddling.tty_escape:13
msgid "The escaped data."
msgstr "エスケープしたデータ。"

#: of pwnlib.util.fiddling.unbits:1
msgid "Converts an iterable of bits into a string."
msgstr "ビットのイテラブルを文字列に変換します。"

#: of pwnlib.util.fiddling.unbits:3
msgid "Iterable of bits"
msgstr "ビットのイテラブル"

#: of pwnlib.util.fiddling.unbits:4
msgid "The string \"little\" or \"big\", which specifies the bits endianness."
msgstr "ビットのエンディアンを指定する文字列 \"little\" または \"big\"。"

#: of pwnlib.util.fiddling.unbits:7
msgid "A string of the decoded bits."
msgstr "デコードしたビットの文字列。"

#: of pwnlib.util.fiddling.unhex:1
msgid "Hex-decodes a string."
msgstr "16 進数の文字列をデコードします。"

#: of pwnlib.util.fiddling.urldecode:1
msgid "URL-decodes a string."
msgstr "文字列を URL デコードします。"

#: of pwnlib.util.fiddling.urlencode:1
msgid "URL-encodes a string."
msgstr "文字列を URL エンコードします。"

#: of pwnlib.util.fiddling.xor:1
msgid "Flattens its arguments using :func:`pwnlib.util.packing.flat` and then xors them together. If the end of a string is reached, it wraps around in the string."
msgstr "引数を :func:`pwnlib.util.packing.flat` で平坦化し、すべてを xor します。文字列の終わりに達した場合は、その文字列の先頭に戻って続けます。"

#: of pwnlib.util.fiddling.xor:5
msgid "The arguments to be xor'ed together."
msgstr "xor する引数。"

#: of pwnlib.util.fiddling.xor:6
msgid "How long a string should be returned. Can be either 'min'/'max'/'left'/'right' or a number."
msgstr "返す文字列の長さ。'min'/'max'/'left'/'right' のいずれか、または数値を指定できます。"

#: of pwnlib.util.fiddling.xor:9
msgid "The string of the arguments xor'ed together."
msgstr "引数を xor した文字列。"

#: of pwnlib.util.fiddling.xor_key:1
msgid "Finds a ``size``-width value that can be XORed with a string to produce ``data``, while neither the XOR value or XOR string contain any bytes in ``avoid``."
msgstr "文字列と XOR すると ``data`` になる ``size`` 幅の値を探します。XOR する値と XOR する文字列のどちらにも、``avoid`` のバイトを含めません。"

#: of pwnlib.util.fiddling.xor_key:5 pwnlib.util.fiddling.xor_pair:4
msgid "The desired string."
msgstr "目的の文字列。"

#: of pwnlib.util.fiddling.xor_key:7 pwnlib.util.fiddling.xor_pair:6
