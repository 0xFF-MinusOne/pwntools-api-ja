msgstr ""

#: of pwnlib.shellcraft.arm.linux.cacheflush:5
msgid "mov   r0, #0 mov   r1, #-1 mov   r2, #0 swi   0x9F0002"
msgstr ""

#: of pwnlib.shellcraft.arm.linux.cacheflush:10
msgid "How this works:"
msgstr ""

#: of pwnlib.shellcraft.arm.linux.cacheflush:12
msgid ""
"... However, SWI generates a software interrupt and to the interrupt "
"handler, 0x9F0002 is actually data and as a result will not be read via "
"the instruction cache, so if we modify the argument to SWI in our self-"
"modifyign code, the argument will be read correctly."
msgstr ""

