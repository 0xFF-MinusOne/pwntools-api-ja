#: pwnlib.shellcraft.amd64.linux.syscall:2
#: pwnlib.shellcraft.arm.linux.syscall:2
#: pwnlib.shellcraft.i386.freebsd.syscall:2
#: pwnlib.shellcraft.i386.linux.syscall:2
