#: pwnlib.shellcraft.arm.memcpy:3 pwnlib.shellcraft.i386.memcpy:3
#: pwnlib.shellcraft.thumb.memcpy:3
msgid "Destination address"
msgstr "宛先アドレス"

#: of pwnlib.shellcraft.aarch64.memcpy:4 pwnlib.shellcraft.amd64.memcpy:4
#: pwnlib.shellcraft.arm.memcpy:4 pwnlib.shellcraft.i386.memcpy:4
#: pwnlib.shellcraft.thumb.memcpy:4
msgid "Source address"
msgstr "コピー元アドレス"

#: of pwnlib.shellcraft.aarch64.memcpy:5 pwnlib.shellcraft.amd64.memcpy:5
#: pwnlib.shellcraft.arm.memcpy:5 pwnlib.shellcraft.i386.memcpy:5
#: pwnlib.shellcraft.thumb.memcpy:5
msgid "Number of bytes"
msgstr "バイト数"

#: of pwnlib.shellcraft.aarch64.mov:1 pwnlib.shellcraft.arm.mov:1
msgid "Move src into dest."
msgstr "src を dest に移動します。"

#: of pwnlib.shellcraft.aarch64.mov:3 pwnlib.shellcraft.arm.mov:3
msgid "Support for automatically avoiding newline and null bytes has to be done."
msgstr "改行とヌルバイトを自動で避ける機能は、まだ実装が必要です。"

#: of pwnlib.shellcraft.aarch64.mov:5 pwnlib.shellcraft.arm.mov:5
msgid "If src is a string that is not a register, then it will locally set `context.arch` to `'arm'` and use :func:`pwnlib.constants.eval` to evaluate the string. Note that this means that this shellcode can change behavior depending on the value of `context.os`."
msgstr "src がレジスタ以外の文字列の場合は、`context.arch` を一時的に `'arm'` にして、:func:`pwnlib.constants.eval` で文字列を評価します。そのため、このシェルコードの動作は `context.os` の値によって変わることがあります。"

#: of pwnlib.shellcraft.aarch64.mov:11 pwnlib.shellcraft.aarch64.pushstr:14
#: pwnlib.shellcraft.arm.mov:11 pwnlib.shellcraft.arm.pushstr:11
#: pwnlib.shellcraft.arm.ret:6 pwnlib.shellcraft.i386.linux.connect:12
msgid "Examples"
msgstr ""

#: of pwnlib.shellcraft.aarch64.mov:23 pwnlib.shellcraft.amd64.mov:78
#: pwnlib.shellcraft.i386.mov:14 pwnlib.shellcraft.loongarch64.mov:8
#: pwnlib.shellcraft.mips.mov:10 pwnlib.shellcraft.riscv64.mov:10
msgid "The destination register."
msgstr "移動先のレジスタ。"

#: of pwnlib.shellcraft.aarch64.mov:25 pwnlib.shellcraft.amd64.mov:80
#: pwnlib.shellcraft.arm.mov:36 pwnlib.shellcraft.i386.mov:16
#: pwnlib.shellcraft.loongarch64.mov:10 pwnlib.shellcraft.mips.mov:12
#: pwnlib.shellcraft.riscv64.mov:12
msgid "Either the input register, or an immediate value."
msgstr "入力レジスタ、または即値。"

#: of pwnlib.shellcraft.aarch64.push:1 pwnlib.shellcraft.amd64.push:1
#: pwnlib.shellcraft.i386.push:1 pwnlib.shellcraft.thumb.push:1
msgid "Pushes a value onto the stack without using null bytes or newline characters."
msgstr "ヌルバイトや改行文字を使わずに、値をスタックにプッシュします。"

#: of pwnlib.shellcraft.aarch64.push:3
msgid "If src is a string, then we try to evaluate using :func:`pwnlib.constants.eval` before determining how to push it."
msgstr "src が文字列の場合は、プッシュ方法を決める前に :func:`pwnlib.constants.eval` で評価を試みます。"

#: of pwnlib.shellcraft.aarch64.push:6
msgid "Note that this means that this shellcode can change behavior depending on the value of `context.os`."
msgstr "そのため、このシェルコードの動作は `context.os` の値によって変わることがあります。"

#: of pwnlib.shellcraft.aarch64.push:11
msgid "AArch64 requires that the stack remain 16-byte aligned at all times, so this alignment is preserved."
msgstr "AArch64 ではスタックを常に 16 バイト境界にそろえておく必要があるため、このアラインメントは保たれます。"

#: of pwnlib.shellcraft.aarch64.push:14 pwnlib.shellcraft.amd64.push:9
#: pwnlib.shellcraft.i386.push:9 pwnlib.shellcraft.thumb.push:9
msgid "The value or register to push"
msgstr "push する値またはレジスタ"

#: of pwnlib.shellcraft.aarch64.push:16
msgid "Scratch register to use"
msgstr "使う作業用レジスタ"

#: of pwnlib.shellcraft.aarch64.push:18
msgid "Second scratch register to use"
msgstr "2 つ目に使う作業用レジスタ"

#: of pwnlib.shellcraft.aarch64.pushstr:1 pwnlib.shellcraft.arm.pushstr:1
#: pwnlib.shellcraft.loongarch64.pushstr:1
msgid "Pushes a string onto the stack."
msgstr "文字列をスタックにプッシュします。"

#: of pwnlib.shellcraft.aarch64.pushstr:3
msgid "r12 is defined as the inter-procedural scratch register ($ip), so this should not interfere with most usage."
msgstr "r12 はプロシージャ間のスクラッチレジスタ ($ip) と定義されているため、ほとんどの使い方では干渉しません。"

#: of pwnlib.shellcraft.aarch64.pushstr:6 pwnlib.shellcraft.amd64.pushstr:53
#: pwnlib.shellcraft.arm.pushstr:3 pwnlib.shellcraft.i386.pushstr:53
#: pwnlib.shellcraft.loongarch64.pushstr:40 pwnlib.shellcraft.mips.pushstr:65
#: pwnlib.shellcraft.riscv64.pushstr:64 pwnlib.shellcraft.thumb.pushstr:4
msgid "The string to push."
msgstr "プッシュする文字列。"

#: of pwnlib.shellcraft.aarch64.pushstr:8 pwnlib.shellcraft.amd64.pushstr:55
#: pwnlib.shellcraft.arm.pushstr:5 pwnlib.shellcraft.i386.pushstr:55
#: pwnlib.shellcraft.loongarch64.pushstr:42 pwnlib.shellcraft.mips.pushstr:67
#: pwnlib.shellcraft.riscv64.pushstr:66 pwnlib.shellcraft.thumb.pushstr:6
msgid "Whether to append a single NULL-byte before pushing."
msgstr "プッシュする前に NULL バイトを 1 つ付けるかどうか。"

#: of pwnlib.shellcraft.aarch64.pushstr:10 pwnlib.shellcraft.arm.pushstr:7
msgid "Temporary register to use.  By default, R7 is used."
msgstr "使用する一時レジスタ。既定では R7 を使います。"

#: of pwnlib.shellcraft.aarch64.pushstr_array:1
#: pwnlib.shellcraft.amd64.pushstr_array:1
#: pwnlib.shellcraft.arm.pushstr_array:1 pwnlib.shellcraft.i386.pushstr_array:1
#: pwnlib.shellcraft.loongarch64.pushstr_array:1
#: pwnlib.shellcraft.mips.pushstr_array:1
#: pwnlib.shellcraft.riscv64.pushstr_array:1
#: pwnlib.shellcraft.thumb.pushstr_array:1
msgid "Pushes an array/envp-style array of pointers onto the stack."
msgstr "ポインタの配列（array / envp 形式）をスタックにプッシュします。"

#: of pwnlib.shellcraft.aarch64.pushstr_array:3
#: pwnlib.shellcraft.amd64.pushstr_array:3
#: pwnlib.shellcraft.arm.pushstr_array:3 pwnlib.shellcraft.i386.pushstr_array:3
#: pwnlib.shellcraft.loongarch64.pushstr_array:3
#: pwnlib.shellcraft.mips.pushstr_array:3
#: pwnlib.shellcraft.riscv64.pushstr_array:3
#: pwnlib.shellcraft.thumb.pushstr_array:3
msgid "Destination register to hold the pointer."
msgstr "ポインタを保持する移動先のレジスタ。"

#: of pwnlib.shellcraft.aarch64.pushstr_array:5
#: pwnlib.shellcraft.amd64.pushstr_array:5
#: pwnlib.shellcraft.arm.pushstr_array:5 pwnlib.shellcraft.i386.pushstr_array:5
#: pwnlib.shellcraft.loongarch64.pushstr_array:5
#: pwnlib.shellcraft.mips.pushstr_array:5
#: pwnlib.shellcraft.riscv64.pushstr_array:5
#: pwnlib.shellcraft.thumb.pushstr_array:5
msgid "Single argument or list of arguments to push. NULL termination is normalized so that each argument ends with exactly one NULL byte."
msgstr "プッシュする引数 1 つ、または引数のリスト。NULL 終端は、各引数がちょうど 1 つの NULL バイトで終わるように正規化されます。"

#: of pwnlib.shellcraft.aarch64.setregs:1 pwnlib.shellcraft.amd64.setregs:1
#: pwnlib.shellcraft.arm.setregs:1 pwnlib.shellcraft.i386.setregs:1
#: pwnlib.shellcraft.loongarch64.setregs:1 pwnlib.shellcraft.mips.setregs:1
#: pwnlib.shellcraft.riscv64.setregs:1 pwnlib.shellcraft.thumb.setregs:1
msgid "Sets multiple registers, taking any register dependencies into account (i.e., given eax=1,ebx=eax, set ebx first)."
msgstr "複数のレジスタを、レジスタ間の依存関係を考慮して設定します（例えば eax=1, ebx=eax なら、先に ebx を設定します）。"

#: of pwnlib.shellcraft.aarch64.setregs:4 pwnlib.shellcraft.amd64.setregs:4
#: pwnlib.shellcraft.arm.setregs:4 pwnlib.shellcraft.i386.setregs:4
#: pwnlib.shellcraft.loongarch64.setregs:4 pwnlib.shellcraft.mips.setregs:4
#: pwnlib.shellcraft.riscv64.setregs:4 pwnlib.shellcraft.thumb.setregs:4
msgid "Desired register context"
msgstr "目的のレジスタの context"

#: of pwnlib.shellcraft.aarch64.setregs:6 pwnlib.shellcraft.amd64.mov:82
#: pwnlib.shellcraft.amd64.setregs:6 pwnlib.shellcraft.arm.setregs:6
#: pwnlib.shellcraft.i386.mov:18 pwnlib.shellcraft.i386.setregs:6
#: pwnlib.shellcraft.loongarch64.setregs:6 pwnlib.shellcraft.mips.setregs:6
#: pwnlib.shellcraft.riscv64.setregs:6 pwnlib.shellcraft.thumb.setregs:6
msgid "Can the stack be used?"
msgstr "スタックを使えるかどうか。"

#: of pwnlib.shellcraft.aarch64.xor:1 pwnlib.shellcraft.amd64.xor:1
#: pwnlib.shellcraft.arm.xor:1 pwnlib.shellcraft.i386.xor:1
msgid "XORs data a constant value."
msgstr "データを定数値で XOR します。"

#: of pwnlib.shellcraft.aarch64.xor:3 pwnlib.shellcraft.arm.xor:3
msgid "XOR key either as a 4-byte integer, If a string, length must be a power of two, and not longer than 4 bytes."
msgstr "XOR の鍵。4 バイトの整数で指定します。文字列の場合は、長さが 2 のべき乗で、4 バイト以下である必要があります。"

#: of pwnlib.shellcraft.aarch64.xor:7 pwnlib.shellcraft.arm.xor:7
msgid "Address of the data (e.g. 0xdead0000, 'rsp')"
msgstr "データのアドレス（例: 0xdead0000、'rsp'）"

#: of pwnlib.shellcraft.aarch64.xor:9 pwnlib.shellcraft.arm.xor:9
msgid "Number of bytes to XOR."
msgstr "XOR するバイト数。"

#: ../pwntools/docs/source/shellcraft/aarch64.rst:19
msgid ":mod:`pwnlib.shellcraft.aarch64.linux`"
msgstr ""

#: of pwnlib.shellcraft.aarch64.linux.cat:1 pwnlib.shellcraft.amd64.linux.cat:1
#: pwnlib.shellcraft.arm.linux.cat:1 pwnlib.shellcraft.i386.linux.cat:1
#: pwnlib.shellcraft.mips.linux.cat:1 pwnlib.shellcraft.thumb.linux.cat:1
msgid "Opens a file and writes its contents to the specified file descriptor."
msgstr "ファイルを開き、その内容を指定したファイルディスクリプタに書き込みます。"

#: of pwnlib.shellcraft.aarch64.linux.cat2:1
#: pwnlib.shellcraft.amd64.linux.cat2:1 pwnlib.shellcraft.arm.linux.cat2:1
#: pwnlib.shellcraft.i386.linux.cat2:1 pwnlib.shellcraft.mips.linux.cat2:1
#: pwnlib.shellcraft.riscv64.linux.cat2:1 pwnlib.shellcraft.thumb.linux.cat2:1
msgid "Opens a file and writes its contents to the specified file descriptor. Uses an extra stack buffer and must know the length."
msgstr "ファイルを開き、その内容を指定したファイルディスクリプタに書き込みます。追加のスタックバッファを使うため、長さが分かっている必要があります。"

#: of pwnlib.shellcraft.aarch64.linux.connect:1
msgid "Connects to the host on the specified port. Network is either 'ipv4' or 'ipv6'. Leaves the connected socket in x12."
msgstr "指定したポートでホストに接続します。Network は 'ipv4' か 'ipv6' です。接続したソケットは x12 に残ります。"

#: of pwnlib.shellcraft.aarch64.linux.dupio:1
msgid "Args: [sock (imm/reg) = x12] Duplicates sock to stdin, stdout and stderr"
msgstr "引数: [sock (imm/reg) = x12] sock を標準入力・標準出力・標準エラーに複製します。"

#: of pwnlib.shellcraft.aarch64.linux.dupsh:1
msgid "Args: [sock (imm/reg) = x12] Duplicates sock to stdin, stdout and stderr and spawns a shell."
msgstr "引数: [sock (imm/reg) = x12] sock を標準入力・標準出力・標準エラーに複製し、シェルを起動します。"

#: of pwnlib.shellcraft.aarch64.linux.echo:1
#: pwnlib.shellcraft.amd64.linux.echo:1 pwnlib.shellcraft.arm.linux.echo:1
#: pwnlib.shellcraft.i386.linux.echo:1 pwnlib.shellcraft.mips.linux.echo:1
#: pwnlib.shellcraft.thumb.linux.echo:1
msgid "Writes a string to a file descriptor"
msgstr "ファイルディスクリプタに文字列を書き込む"

#: of pwnlib.shellcraft.aarch64.linux.forkexit:1
#: pwnlib.shellcraft.amd64.linux.forkexit:1
#: pwnlib.shellcraft.arm.linux.forkexit:1
#: pwnlib.shellcraft.i386.linux.forkexit:1
#: pwnlib.shellcraft.mips.linux.forkexit:1
#: pwnlib.shellcraft.thumb.linux.forkexit:1
msgid "Attempts to fork.  If the fork is successful, the parent exits."
msgstr "fork を試みます。fork に成功した場合、親プロセスは終了します。"

#: of pwnlib.shellcraft.aarch64.linux.kill:1
#: pwnlib.shellcraft.amd64.linux.kill:1 pwnlib.shellcraft.arm.linux.kill:1
#: pwnlib.shellcraft.i386.linux.kill:1 pwnlib.shellcraft.mips.linux.kill:1
#: pwnlib.shellcraft.riscv64.linux.kill:1 pwnlib.shellcraft.thumb.linux.kill:1
msgid "Invokes the syscall kill."
msgstr "システムコール kill を呼び出します。"

#: of pwnlib.shellcraft.aarch64.linux.kill:3
#: pwnlib.shellcraft.amd64.linux.kill:3 pwnlib.shellcraft.arm.linux.kill:3
#: pwnlib.shellcraft.i386.linux.kill:3 pwnlib.shellcraft.mips.linux.kill:3
#: pwnlib.shellcraft.riscv64.linux.kill:3 pwnlib.shellcraft.thumb.linux.kill:3
msgid "See 'man 2 kill' for more information."
msgstr "詳しくは 'man 2 kill' を参照してください。"

