#: pwnlib.shellcraft.thumb.linux.syscall:2
msgid "Does a syscall"
msgstr "システムコールを呼ぶ"

#: of pwnlib.shellcraft.aarch64.linux.syscall:4
#: pwnlib.shellcraft.amd64.linux.syscall:4
#: pwnlib.shellcraft.arm.linux.syscall:4
#: pwnlib.shellcraft.i386.freebsd.syscall:4
#: pwnlib.shellcraft.i386.linux.syscall:4
