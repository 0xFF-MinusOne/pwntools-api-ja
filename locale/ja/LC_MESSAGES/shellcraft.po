msgstr "別のプロセスを実行します。"

#: of pwnlib.shellcraft.aarch64.linux.sleep:1
#: pwnlib.shellcraft.amd64.linux.sleep:1 pwnlib.shellcraft.arm.linux.sleep:1
#: pwnlib.shellcraft.i386.linux.sleep:1 pwnlib.shellcraft.mips.linux.sleep:1
#: pwnlib.shellcraft.riscv64.linux.sleep:1
#: pwnlib.shellcraft.thumb.linux.sleep:1
