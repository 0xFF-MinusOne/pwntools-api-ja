msgstr "スリープする時間（秒）。"

#: of pwnlib.shellcraft.aarch64.linux.socket:1
#: pwnlib.shellcraft.amd64.linux.socket:1 pwnlib.shellcraft.i386.linux.socket:1
msgid "Creates a new socket"
msgstr "新しいソケットを作る"

#: of pwnlib.shellcraft.aarch64.linux.stage:1
#: pwnlib.shellcraft.amd64.linux.stage:1 pwnlib.shellcraft.i386.linux.stage:1
#: pwnlib.shellcraft.thumb.linux.stage:1
msgid "Migrates shellcode to a new buffer."
msgstr "シェルコードを新しいバッファに移します。"

#: of pwnlib.shellcraft.aarch64.linux.stage:3
#: pwnlib.shellcraft.amd64.linux.stage:3 pwnlib.shellcraft.i386.linux.stage:3
#: pwnlib.shellcraft.thumb.linux.stage:3
msgid "Integer file descriptor to recv data from. Default is stdin (0)."
msgstr "データを受信するファイルディスクリプタ（整数）。既定は標準入力（0）です。"

#: of pwnlib.shellcraft.aarch64.linux.stage:6
#: pwnlib.shellcraft.amd64.linux.stage:6 pwnlib.shellcraft.i386.linux.stage:6
#: pwnlib.shellcraft.thumb.linux.stage:6
