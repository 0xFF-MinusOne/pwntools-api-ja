#: ../pwntools/docs/source/flag.rst:7
msgid ":mod:`pwnlib.flag` --- CTF Flag Management"
msgstr ":mod:`pwnlib.flag` --- CTF のフラグ管理"

#: of pwnlib.flag.flag.submit_flag:1
msgid "Submits a flag to the game server"
msgstr "ゲームサーバーにフラグを提出する"

#: of pwnlib.flag.flag.submit_flag
msgid "Parameters"
msgstr "引数"

#: of pwnlib.flag.flag.submit_flag:3
msgid "The flag to submit."
msgstr "提出するフラグです。"

#: of pwnlib.flag.flag.submit_flag:5
msgid "Exploit identifier, optional"
msgstr "エクスプロイトの識別子 (省略可)"

#: of pwnlib.flag.flag.submit_flag:7
msgid "Target identifier, optional"
msgstr "攻撃対象の識別子 (省略可)"

#: of pwnlib.flag.flag.submit_flag:9
msgid "Flag server host name, optional"
msgstr "フラグサーバーのホスト名 (省略可)"

#: of pwnlib.flag.flag.submit_flag:11
msgid "Flag server port, optional"
msgstr "フラグサーバーのポート (省略可)"

#: of pwnlib.flag.flag.submit_flag:13
msgid "Team identifier, optional"
msgstr "チームの識別子 (省略可)"

#: of pwnlib.flag.flag.submit_flag:16
msgid "Optional arguments are inferred from the environment, or omitted if none is set."
msgstr "省略可能な引数は、環境から推測されます。何も設定されていなければ省略されます。"

#: of pwnlib.flag.flag.submit_flag
msgid "Returns"
msgstr "戻り値"

#: of pwnlib.flag.flag.submit_flag:19
msgid "A string indicating the status of the key submission, or an error code."
msgstr "キーの提出結果を示す文字列、またはエラーコードです。"

#: of pwnlib.flag.flag.submit_flag:22
msgid "Doctest:"
msgstr "doctest:"
