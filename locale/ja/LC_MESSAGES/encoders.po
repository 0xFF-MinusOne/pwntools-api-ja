#: ../pwntools/docs/source/encoders.rst:10
msgid ":mod:`pwnlib.encoders` --- Encoding Shellcode"
msgstr ":mod:`pwnlib.encoders` --- シェルコードのエンコード"

#: of pwnlib.encoders.encoder.alphanumeric:1
msgid "Encode the shellcode ``raw_bytes`` such that it does not contain any bytes except for [A-Za-z0-9]."
msgstr "シェルコード ``raw_bytes`` を、[A-Za-z0-9] 以外のバイトを含まないようにエンコードします。"

#: of pwnlib.encoders.encoder.alphanumeric:4 pwnlib.encoders.encoder.line:4
#: pwnlib.encoders.encoder.null:4 pwnlib.encoders.encoder.printable:4
#: pwnlib.encoders.encoder.scramble:3
msgid "Accepts the same arguments as :func:`encode`."
msgstr ":func:`encode` と同じ引数を受け取ります。"

#: of pwnlib.encoders.encoder.encode:1
msgid "Encode shellcode ``raw_bytes`` such that it does not contain any bytes in ``avoid`` or ``expr``."
msgstr "シェルコード ``raw_bytes`` を、``avoid`` や ``expr`` に含まれるバイトを含まないようにエンコードします。"

#: ../pwntools/docs/source/encoders.rst of
#: pwnlib.encoders.i386.ascii_shellcode.AsciiShellcodeEncoder.__call__
#: pwnlib.encoders.i386.ascii_shellcode.AsciiShellcodeEncoder._calc_subtractions
