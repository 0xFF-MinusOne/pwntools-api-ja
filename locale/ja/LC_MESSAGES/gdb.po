msgstr ""

#: of pwnlib.gdb.attach:26
msgid "The ``target`` argument is very robust, and can be any of the following:"
msgstr "``target`` 引数はとても柔軟で、次のどれでも指定できます。"

#: of pwnlib.gdb.attach:28
msgid ":obj:`int`"
msgstr ""

#: of pwnlib.gdb.attach:29
msgid "PID of a process"
msgstr "プロセスの PID"

#: of pwnlib.gdb.attach:30
msgid ":obj:`str`"
msgstr ""

#: of pwnlib.gdb.attach:31
msgid "Process name.  The youngest process is selected."
msgstr "プロセス名。最も新しいプロセスが選ばれます。"

#: of pwnlib.gdb.attach:32
msgid ":obj:`tuple`"
msgstr ""

