#: of pwnlib.gdb._gdbserver_args:4
msgid "Process ID to attach to"
msgstr "アタッチするプロセス ID"

#: of pwnlib.gdb._gdbserver_args:6
msgid "Process to launch"
msgstr "起動するプロセス"

#: of pwnlib.gdb._gdbserver_args:8
msgid "Port to use for gdbserver, default: random"
msgstr "gdbserver が使うポート。既定値はランダムです。"

#: of pwnlib.gdb._gdbserver_args:10 pwnlib.gdb.debug:18
msgid "List of additional arguments to pass to gdbserver"
msgstr "gdbserver に渡す追加の引数のリスト"

#: of pwnlib.gdb._gdbserver_args:12
msgid "List of arguments to provide on the debugger command line"
msgstr "デバッガーのコマンドラインに渡す引数のリスト"

#: of pwnlib.gdb._gdbserver_args:18
