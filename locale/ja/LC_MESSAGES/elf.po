msgid "Kernel-specific ELF functionality"
msgstr "カーネル固有の ELF の機能です。"

#: of pwnlib.elf.config.parse_kconfig:1
msgid "Parses configuration data from a kernel .config."
msgstr "カーネルの .config から設定データを解析します。"

