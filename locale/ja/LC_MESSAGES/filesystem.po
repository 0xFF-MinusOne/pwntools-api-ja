msgid "Todo"
msgstr ""

#: of pwnlib.filesystem.ssh.SSHPath.symlink_to:5
msgid "Paramiko's documentation is wrong and inverted. https://github.com/paramiko/paramiko/issues/1821"
msgstr "Paramiko の文書は誤っていて、逆になっています。https://github.com/paramiko/paramiko/issues/1821"

#: of pwnlib.filesystem.ssh.SSHPath.touch:1
msgid "Touch a file (i.e. make it exist)"
msgstr "ファイルを touch します(つまり、存在させます)"

#: of pwnlib.filesystem.ssh.SSHPath.unlink:1
msgid "Remove an existing file."
msgstr "既存のファイルを削除します。"

#: of pwnlib.filesystem.ssh.SSHPath.unlink:5
msgid ""
"This test fails catastrophically if the file name is unlink_me (note the "
"underscore)"
msgstr ""

#: of pwnlib.filesystem.ssh.SSHPath.unlink:20
msgid "Note that unlink only works on files."
msgstr "unlink はファイルに対してしか動作しないことに注意してください。"

#: of pwnlib.filesystem.ssh.SSHPath.with_name:1
msgid "Return a new path with the file name changed"
msgstr ""

#: of pwnlib.filesystem.ssh.SSHPath.with_stem:1
msgid "Return a new path with the stem changed."
msgstr "stem を変更した新しいパスを返します。"

#: of pwnlib.filesystem.ssh.SSHPath.with_suffix:1
msgid "Return a new path with the file suffix changed"
msgstr ""

