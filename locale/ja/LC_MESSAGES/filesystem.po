#: ../pwntools/docs/source/filesystem.rst:13
msgid ":mod:`pwnlib.filesystem` --- Manipulating Files Locally and Over SSH"
msgstr ""

#: ../pwntools/docs/source/filesystem.rst:15
msgid ""
"Provides a Python2-compatible :py:mod:`pathlib` interface for paths on "
"the local filesystem (`.Path`) as well as on remote filesystems, via SSH "
"(`.SSHPath`)."
msgstr ""

#: of pwnlib.filesystem:1
msgid "Handles file abstraction for local vs. remote (via ssh)"
msgstr ""

#: of pathlib.Path:1
msgid "PurePath subclass that can make system calls."
msgstr ""

#: of pathlib.Path:3
msgid ""
"Path represents a filesystem path but unlike PurePath, also offers "
"methods to do system calls on path objects. Depending on your system, "
"instantiating a Path will return either a PosixPath or a WindowsPath "
"object. You can also instantiate a PosixPath or WindowsPath directly, but"
" cannot instantiate a WindowsPath on a POSIX system or vice versa."
msgstr ""

#: of pathlib.Path:9 pathlib.Path.__new__:1 pwnlib.filesystem.ssh.SSHPath:48
msgid ""
"Construct a PurePath from one or several strings and or existing PurePath"
" objects.  The strings and path objects are combined so as to yield a "
"canonicalized path, which is incorporated into the new PurePath object."
msgstr ""

#: of pathlib.Path.cwd:1 pwnlib.filesystem.SSHPath.cwd:1
msgid "Return a new path pointing to the current working directory."
msgstr ""

#: of pathlib.Path.home:1
msgid ""
"Return a new path pointing to the user's home directory (as returned by "
"os.path.expanduser('~'))."
msgstr ""

#: of pathlib.Path.absolute:1
msgid ""
"Return an absolute version of this path by prepending the current working"
" directory. No normalization or symlink resolution is performed."
msgstr ""

#: of pathlib.Path.absolute:4
msgid "Use resolve() to get the canonical path to a file."
msgstr ""

#: of pathlib.Path.chmod:1
msgid "Change the permissions of the path, like os.chmod()."
msgstr ""

#: of pathlib.Path.exists:1
msgid "Whether this path exists."
msgstr ""

#: of pathlib.Path.exists:3
msgid ""
"This method normally follows symlinks; to check whether a symlink exists,"
" add the argument follow_symlinks=False."
msgstr ""

#: of pathlib.Path.expanduser:1
msgid ""
"Return a new path with expanded ~ and ~user constructs (as returned by "
"os.path.expanduser)"
msgstr ""

#: of pathlib.Path.glob:1 pwnlib.filesystem.ssh.SSHPath.glob:1
msgid ""
"Iterate over this subtree and yield all existing files (of any kind, "
"including directories) matching the given relative pattern."
msgstr ""

